{
  "name": "highlightjs-carve",
  "version": "0.1.9",
  "description": "Carve markup language definition for highlight.js",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./carve.js": "./src/languages/carve.js",
    "./carve.mjs": "./src/languages/carve.mjs",
    "./delimited.js": "./src/languages/delimited.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "test": "node test/carve-inventory.mjs && node test/pin-drift.mjs"
  },
  "keywords": [
    "carve",
    "crv",
    "highlight.js",
    "highlightjs",
    "hljs",
    "syntax",
    "syntax-highlighting",
    "markup",
    "markup-language"
  ],
  "author": "markup-carve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/highlightjs-carve.git"
  },
  "bugs": {
    "url": "https://github.com/markup-carve/highlightjs-carve/issues"
  },
  "homepage": "https://markup-carve.github.io/carve/",
  "peerDependencies": {
    "highlight.js": "^11"
  },
  "devDependencies": {
    "highlight.js": "^11.11.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#8d1923ee"
  }
}
